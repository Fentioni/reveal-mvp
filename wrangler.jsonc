{
  "name": "reveal-mvp",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-12",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reveal-db",
      "database_id": "94356ca3-17f9-4b9a-9f5c-f103c13b9173"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "reveal-images"
    }
  ]
}
