{
  "name": "reveal-stage4b-test",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "STRIPE_LIVE_MODE": "false",
    "STAGING_DISABLE_CHECKOUT": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revealstage4b",
      "database_id": "fbc9687a-642b-42e6-ba8d-56430867e857"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "reveal-images-stage4b"
    }
  ]
}
